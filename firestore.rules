rules_version = '2';

// The app talks to Firestore only through the server-side service account
// (google-cloud-firestore with GOOGLE_APPLICATION_CREDENTIALS), which
// bypasses these rules entirely. This file exists so `firebase deploy` and
// the emulator have something to load - there is no client-side access to
// lock down.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
