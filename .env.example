# StockLens-AI credentials.
#
# Copy to .env and fill in. .env is gitignored - never commit it.
#
#   cp .env.example .env
#
# From Phase 2 the Toss credential carries ORDER-EXECUTION rights, not just
# read access. Treat it like a banking password: never paste it into a chat,
# an issue, or a screenshot. If it is ever exposed, reissue it in the Toss WTS
# immediately - reissuing also invalidates the leaked token instantly.

# Toss Securities Open API
# WTS > 설정 > Open API 에서 발급. 같은 화면에서 허용 IP 등록도 필요합니다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# Google AI Studio (AI Analyst). Optional - the report runs without it.
GOOGLE_AI_API_KEY=

# Notion daily report.
# Create an Internal integration at https://www.notion.so/profile/integrations,
# then connect it to the target database (page > ... > Connections). Without
# that connection the API returns 404 even with a valid token.
NOTION_TOKEN=
NOTION_DATABASE_ID=
